#!/usr/bin/env bash
# Guardián de push: NADA sale con una suite rota.
# Se activa una vez:  git config core.hooksPath .githooks
# Ronda 4: la lista manual se retiró (derivaba del Makefile — 6 suites de
# deriva acumulada): el hook ejecuta `make fast`, LA MISMA definición que
# usa el día a día. Una sola fuente de verdad para el gate rápido.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "[pre-push] make fast (la misma definición del Makefile — sin listas a la deriva):"
if ! make fast; then
  echo "  ✗ make fast ROJO — push cancelado."
  exit 1
fi
echo "[pre-push] verde. Empujando…"
