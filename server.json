{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kinti/a11y-toolkit",
  "title": "A11Y Toolkit",
  "description": "The accessibility layer for AI coding agents: audit, fix, document and watch - WCAG 2.2.",
  "websiteUrl": "https://a11y.es",
  "repository": {
    "url": "https://github.com/kinti/a11y-toolkit",
    "source": "github"
  },
  "version": "5.22.2",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "a11y-toolkit",
      "version": "5.22.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--from"
        },
        {
          "type": "positional",
          "value": "a11y-toolkit"
        },
        {
          "type": "positional",
          "value": "a11y-toolkit-mcp"
        }
      ]
    },
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@kinti/a11y-toolkit",
      "version": "5.22.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "-y"
        },
        {
          "type": "positional",
          "value": "@kinti/a11y-toolkit"
        },
        {
          "type": "positional",
          "value": "a11y-toolkit-mcp"
        }
      ]
    }
  ]
}
