{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinti/a11y-toolkit/blob/main/docs/audit-report.schema.json",
  "title": "a11y-toolkit audit report",
  "description": "Formal schema for any audit report produced by a11y-toolkit (static, rendered, reflow, keyboard, scroll, forms, hover, w3c-nu). Validated programmatically — a consumer can trust the shape without reading the code.",
  "type": "object",
  "required": ["url", "mode", "score", "summary", "findings"],
  "properties": {
    "url": {
      "type": "string",
      "description": "The audited URL or '(html)' for inline HTML"
    },
    "mode": {
      "type": "string",
      "enum": ["static", "rendered", "reflow", "keyboard", "scroll", "forms", "hover", "w3c-nu", "site"],
      "description": "The audit mode that produced this report"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Weighted score: high −12, medium −6, low −2 from 100"
    },
    "score_note": {
      "type": "string",
      "description": "Honesty note about what the score measures"
    },
    "summary": {
      "type": "object",
      "required": ["high", "medium", "low"],
      "properties": {
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 }
      },
      "description": "Finding counts by severity"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "criterion", "signal", "issue", "remediation"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "criterion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+\\s.+",
            "description": "WCAG criterion code and name (e.g. '1.4.3 Contrast (Minimum)')"
          },
          "signal": {
            "type": "string",
            "description": "Stable signal identifier (e.g. 'img_no_alt', 'contrast_fail')"
          },
          "issue": {
            "type": "string",
            "minLength": 10,
            "description": "What was found, with measured values when available"
          },
          "remediation": {
            "type": "string",
            "minLength": 10,
            "description": "Concrete fix the agent can apply"
          },
          "examples": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 6,
            "description": "Specific elements that triggered the finding"
          },
          "status": {
            "type": "string",
            "enum": ["confirmed", "rejected"],
            "description": "Verification status (present when the disprover has run)"
          },
          "reject_reason": {
            "type": "string",
            "description": "Why the finding was rejected (present when status=rejected)"
          },
          "disprover_status": {
            "type": "string",
            "enum": ["confirmed", "rejected", "not-rechecked"],
            "description": "Disprover outcome per finding (a11y_disprove output)"
          }
        }
      }
    },
    "limits": {
      "type": "string",
      "description": "Honest scope note about what automation cannot check"
    },
    "elements_scanned": {
      "type": "integer",
      "description": "Total elements parsed (static mode)"
    },
    "interactive_elements": {
      "type": "integer",
      "description": "Interactive elements found (rendered mode)"
    },
    "shadow_roots": {
      "type": "integer",
      "description": "Open shadow roots traversed (rendered mode)"
    },
    "nested_iframes": {
      "type": "integer",
      "description": "Same-origin iframes scanned (rendered mode)"
    },
    "discovery": {
      "type": "string",
      "enum": ["sitemap", "links"],
      "description": "Page discovery strategy (site mode)"
    },
    "pages": {
      "type": "integer",
      "description": "Pages audited (site mode)"
    },
    "mean_score": {
      "type": "integer",
      "description": "Mean score across pages (site mode)"
    },
    "worst_score": {
      "type": "integer",
      "description": "Lowest page score (site mode)"
    },
    "recurring_signals": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Signals repeating across pages, most frequent first (site mode)"
    },
    "reports": {
      "type": "array",
      "description": "Per-page reports (site mode)"
    },
    "invalid_fields": {
      "type": "integer",
      "description": "Fields filled with invalid data (forms mode)"
    },
    "detail": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Per-field error judgment (forms mode)"
    },
    "batches": {
      "type": "integer",
      "description": "Scroll batches loaded (scroll mode)"
    },
    "end_reached": {
      "type": "boolean",
      "description": "Whether the feed ended (scroll mode)"
    },
    "live_announcements": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Live-region announcements captured (scroll mode)"
    },
    "load_more_alternative": {
      "type": "boolean",
      "description": "Whether a load-more alternative exists (scroll mode)"
    },
    "steps": {
      "type": "integer",
      "description": "Tab stops walked (keyboard mode)"
    },
    "tab_stops": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tab stop descriptions (keyboard mode)"
    },
    "cycle": {
      "type": "object",
      "description": "Keyboard trap cycle info: {detected, elements[], escape_releases} (keyboard mode)"
    },
    "measurements": {
      "type": "object",
      "description": "Reflow measurements: {reflow_320: {scroll, viewport, ok}} (reflow mode)"
    }
  },
  "additionalProperties": true
}
